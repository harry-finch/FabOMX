{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FabOMX",
  "version": "1.0.0",
  "identifier": "fr.fablab.fabomx",
  "build": {
    "beforeBuildCommand": "npm --prefix ../ui run build",
    "frontendDist": "../../ui/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "FabOMX",
        "width": 1440,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 640,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico", "icons/icon.png"],
    "category": "Utility",
    "copyright": "© 2026 Stéphane Muller — GPL-3.0-or-later",
    "license": "GPL-3.0-or-later",
    "licenseFile": "../../LICENSE",
    "shortDescription": "Parcours d’outils pour la ProtoMAX",
    "longDescription": "FabOMX prépare les dessins SVG et DXF pour la découpeuse jet d'eau ProtoMAX (OMAX) : import, placement sur le plateau, nettoyage, côtés de coupe, qualités, amorces, onglets, ordre de coupe, et export du parcours en OMX pour MAKE. Rust et Svelte, GPL-3.0-or-later.",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    }
  }
}
