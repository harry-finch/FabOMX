{
  "name": "fabomx-ui",
  "private": true,
  "version": "1.0.0",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "wasm": "wasm-pack build ../crates/fabomx-wasm --target web --release --out-dir ../../ui/src/wasm --out-name fabomx --no-pack",
    "dev": "vite",
    "build": "npm run wasm && vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "desktop": "cd ../crates/fabomx-desktop && npm exec --yes --package=@tauri-apps/cli@2.12.3 -- tauri build --bundles app && rm -rf ../../dist-desktop && mkdir -p ../../dist-desktop && cp -R target/release/bundle/macos/FabOMX.app ../../dist-desktop/"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tsconfig/svelte": "^5.0.8",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "typescript": "~6.0.3",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@lucide/svelte": "^1.61.0"
  }
}
